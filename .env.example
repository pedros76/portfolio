# ==============================================================
# PETER KIPLAGAT MISIK PORTFOLIO — ENVIRONMENT CONFIGURATION
# ==============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Google Gemini API Keys (Multi-Key Pool for Load Balancing & Failover)
# Kept securely on the backend server — NOT exposed to the client
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash

# Contact Form / Email Configuration (Server-Side)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
CONTACT_EMAIL_RECEIVER=petermisik86@gmil.com

# Frontend Configuration
# Optional: Set VITE_API_URL if frontend is deployed separately from backend
# VITE_API_URL=http://localhost:5000
